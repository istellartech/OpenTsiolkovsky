{
  "name": "openTsiolkovsky-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "(test -f src/wasm/openTsiolkovsky.js || vp run build:wasm) && vp dev",
    "build:wasm": "bash ../scripts/wasm_build.sh",
    "build:optimization": "bash ../scripts/optimization_wasm_build.sh",
    "dev:optimization": "vp run build:optimization && vp run dev",
    "build": "vp run build:wasm && vp run build:optimization && vp check && vp build",
    "vercel-build": "vp run build",
    "preview": "vp preview"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5",
    "@fontsource/ibm-plex-sans-jp": "^5",
    "cesium": "1.146.0",
    "chart.js": "^4.5.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.379.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@types/node": "^24",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plugin-static-copy": "^4",
    "vite-plus": "1.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
  }
}
